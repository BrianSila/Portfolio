# API Configuration
# During development, Vite proxies /api/* to http://localhost:5000 (see vite.config.js)
# For production, set this to your deployed backend URL (e.g., https://api.yourportfolio.com)
VITE_API_BASE_URL=

# Optional: Analytics or third-party service keys
# VITE_ANALYTICS_KEY=
# VITE_SENTRY_DSN=
